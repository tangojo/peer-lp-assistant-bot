{
  "name": "peer-lp-bot",
  "version": "0.1.0",
  "description": "Peer (ZKP2P) Liquidity Provider Assistant Bot",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "peer-lp": "./dist/cli/index.js"
  },
  "dependencies": {
    "@fastify/bearer-auth": "^10.1.2",
    "@zkp2p/contracts-v2": "^0.0.9",
    "commander": "^13.1.0",
    "cosmiconfig": "^9.0.0",
    "ethers": "^6.14.0",
    "fastify": "^5.7.4",
    "grammy": "^1.35.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sql.js": "^1.12.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "private": true
}
