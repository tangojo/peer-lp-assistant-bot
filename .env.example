# Peer LP Assistant Bot — Environment Variables

# Wallet (REQUIRED for auto-spread in Phase 4)
# PEER_LP_PRIVATE_KEY=0x...

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Revolut Business API (Phase 3)
# REVOLUT_ACCESS_TOKEN=
# REVOLUT_REFRESH_TOKEN=

# REST API Key (Phase 2)
# PEER_LP_API_KEY=

# Base RPC (optional, defaults to public RPC)
# BASE_RPC_URL=https://mainnet.base.org
# BASE_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
